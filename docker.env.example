# OPTIONAL. `docker compose up --build` works without this file. Copy to docker.env and edit to change settings;
# docker.env is read by docker-compose.yml and is never put into the image.
#
# There is no model key here: each person saves their own model (provider, model, API key) in the web app, and the
# key is stored encrypted in the database.

# ---- strongly recommended -------------------------------------------------------------------------------------
# Signs the session cookies. Keep it the same across restarts or everyone is signed out.
SESSION_SECRET=
# Encrypts the saved API keys. Generate with:
#   docker run --rm website-test-pipeline python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Without it a key file is created inside the data volume (next to the database), which protects less.
SECRETS_KEY=

# ---- who may use it -------------------------------------------------------------------------------------------
# Anyone who can reach the server may create an account (throttled per address). New accounts per day, all addresses;
# 0 closes sign-ups.
MAX_SIGNUPS_PER_DAY=100
SIGNUPS_PER_ADDRESS_PER_HOUR=3
MAX_JOBS_PER_DAY=5
# Set to 1 when the app is served over HTTPS (behind a reverse proxy), and TRUST_PROXY=1 so limits see real addresses.
COOKIE_SECURE=0
TRUST_PROXY=0

# ---- what a run may do ----------------------------------------------------------------------------------------
# Each run is a real browser: size these to the server's memory (about 1.5 GB per concurrent run).
MAX_CONCURRENT_JOBS=2
MAX_PAGES_LIMIT=25
JOB_TIMEOUT_S=3600
EXECUTE_CONCURRENCY=2
GENERATE_CONCURRENCY=4
# 1 lets people test sites on private networks (a staging server on your LAN / VPN). Leave 0 on a shared server.
ALLOW_PRIVATE_TARGETS=0
ALLOW_PRIVATE_MODEL_URLS=0

# ---- what is kept in the database -----------------------------------------------------------------------------
STORE_FILES_IN_DB=1
MAX_STORED_FILE_MB=30
MAX_STORED_RUN_MB=250
