# Secrets and local configuration
.env
.env.*
!.env.example

# Saved login sessions (a session is as sensitive as a password) - explicit, so a
# `--commit` force-add of anything under runs/ can never pick them up.
auth/
**/auth/
*.storage_state.json

# Per-site workspaces: generated specs, evidence, artifacts, reports.
# `website-tests generate --commit` / `report --commit` force-adds
# runs/<site>/tests + urls.txt past this rule when you want a run tracked.
runs/
python_tests/
python_artifacts/
reports/
evidence.json
results.json
generation-debug.log
generation-*.manifest.json
traces/

# Python and editor files
__pycache__/
*.py[cod]
.pytest_cache/
.vscode/
.idea/
Thumbs.db
.env
Desktop.ini

# Tooling
graphify-out/

# Personal learning notes
EXPLAIN.md
